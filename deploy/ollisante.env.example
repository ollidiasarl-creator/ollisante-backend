# Modèle du fichier /etc/ollisante/ollisante.env sur le serveur.
# Ne JAMAIS le mettre dans Git, ni le coller dans un message ou un chat.

# L'API n'écoute que sur la machine : seul Nginx (HTTPS) y accède.
SERVER_ADDRESS=127.0.0.1

DB_URL=jdbc:postgresql://localhost:5432/ollisante
DB_USER=ollisante
DB_PASSWORD=

# Au moins 32 caractères aléatoires : openssl rand -base64 48
JWT_SECRET=

# Premier démarrage uniquement, puis supprimer ces deux lignes
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Paiement (utilisés à l'étape paiement). Bac à sable d'abord ; production = autre adresse ET autre jeton.
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=

# Version web de l'application (adresses séparées par des virgules). Vide si pas de version web.
CORS_ALLOWED_ORIGINS=
