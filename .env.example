# Variables à définir en production (ne jamais commiter le vrai .env)
DB_URL=jdbc:postgresql://localhost:5432/ollisante
DB_USER=ollisante
DB_PASSWORD=change-me
# Au moins 32 caractères aléatoires. Générer avec : openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-secret
# Premier démarrage uniquement : crée l'administrateur, puis supprimer ces deux lignes.
BOOTSTRAP_ADMIN_EMAIL=admin@votre-domaine.com
BOOTSTRAP_ADMIN_PASSWORD=un-mot-de-passe-long-et-unique
SERVER_ADDRESS=127.0.0.1
# Paiement : bac à sable d'abord
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
CORS_ALLOWED_ORIGINS=
